<?xml version="1.0" encoding="utf-8"?>
<!--
  NanoOmni URDF (ROS2 修正版, 由 SolidWorks 导出的 ROS1 xacro 展开生成)
  - 拼写修正:  base_laser_lnik -> base_laser_link
  - 去除 $(arg robot_name)/ namespace
  - wheel joint 改为 fixed (建图无需 joint_state_publisher 提供轮子状态)
-->
<robot name="NanoOmni">

  <!-- ========================================================== -->
  <!--                base_footprint -> base_link                  -->
  <!-- ========================================================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0.0 0.0 0.0325" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.041429 0.00023721 0.0417" rpy="0 0 0"/>
      <mass value="0.41342"/>
      <inertia
        ixx="0.00064742" ixy="2.7616E-06"  ixz="-5.8305E-06"
        iyy="0.0002294"  iyz="-3.2844E-07"
        izz="0.00081432"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nanoomni_description/meshes/base_link.STL"/>
      </geometry>
      <material name="base_link_color">
        <color rgba="0.14902 0.14902 0.14902 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nanoomni_description/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================================================== -->
  <!--                    Mecanum wheels (×4)                      -->
  <!-- ========================================================== -->
  <!-- Front Left -->
  <link name="front_left_wheel_link">
    <inertial>
      <origin xyz="5.2978E-08 -1.9013E-07 -0.0015791" rpy="0 0 0"/>
      <mass value="0.062971"/>
      <inertia
        ixx="1.2204E-05" ixy="-1.4876E-10" ixz="9.6671E-11"
        iyy="1.2204E-05" iyz="-7.8703E-11"
        izz="1.6521E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nanoomni_description/meshes/front_left_wheel_link.STL"/>
      </geometry>
      <material name="wheel_color"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nanoomni_description/meshes/front_left_wheel_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="fixed">
    <origin xyz="0.0746 0.089266 0" rpy="-1.5708 0 0"/>
    <parent link="base_link"/>
    <child  link="front_left_wheel_link"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Front Right -->
  <link name="front_right_wheel_link">
    <inertial>
      <origin xyz="5.2978E-08 -1.9013E-07 -0.0015791" rpy="0 0 0"/>
      <mass value="0.062971"/>
      <inertia
        ixx="1.2204E-05" ixy="-1.4876E-10" ixz="9.6671E-11"
        iyy="1.2204E-05" iyz="-7.8703E-11"
        izz="1.6521E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nanoomni_description/meshes/front_right_wheel_link.STL"/>
      </geometry>
      <material name="wheel_color"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nanoomni_description/meshes/front_right_wheel_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="fixed">
    <origin xyz="0.0746 -0.089266 0" rpy="-1.5708 0 0"/>
    <parent link="base_link"/>
    <child  link="front_right_wheel_link"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Back Left -->
  <link name="back_left_wheel_link">
    <inertial>
      <origin xyz="5.2978E-08 -1.9013E-07 -0.0015791" rpy="0 0 0"/>
      <mass value="0.062971"/>
      <inertia
        ixx="1.2204E-05" ixy="-1.4876E-10" ixz="9.6671E-11"
        iyy="1.2204E-05" iyz="-7.8703E-11"
        izz="1.6521E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nanoomni_description/meshes/back_left_wheel_link.STL"/>
      </geometry>
      <material name="wheel_color"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nanoomni_description/meshes/back_left_wheel_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="back_left_wheel_joint" type="fixed">
    <origin xyz="-0.0746 0.089266 0" rpy="-1.5708 0 0"/>
    <parent link="base_link"/>
    <child  link="back_left_wheel_link"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Back Right -->
  <link name="back_right_wheel_link">
    <inertial>
      <origin xyz="5.2978E-08 -1.9013E-07 -0.0015791" rpy="0 0 0"/>
      <mass value="0.062971"/>
      <inertia
        ixx="1.2204E-05" ixy="-1.4876E-10" ixz="9.6671E-11"
        iyy="1.2204E-05" iyz="-7.8703E-11"
        izz="1.6521E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nanoomni_description/meshes/back_right_wheel_link.STL"/>
      </geometry>
      <material name="wheel_color"><color rgba="1 1 1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nanoomni_description/meshes/back_right_wheel_link.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="back_right_wheel_joint" type="fixed">
    <origin xyz="-0.0746 -0.089266 0" rpy="-1.5708 0 0"/>
    <parent link="base_link"/>
    <child  link="back_right_wheel_link"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ========================================================== -->
  <!--                       Sensors                               -->
  <!-- ========================================================== -->
  <!-- depth camera -->
  <link name="camera_link"/>
  <joint name="ir_camera_joint" type="fixed">
    <origin xyz="0.10485 0.0375 0.064184" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="camera_link"/>
  </joint>

  <!-- rgb camera -->
  <link name="base_camera_link"/>
  <joint name="base_camera_joint" type="fixed">
    <origin xyz="0.099 -0.0001 0.1077" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="base_camera_link"/>
  </joint>

  <!-- 2D LiDAR (YDLidar S4): 雷达物理坐标系相对车体旋转 180° -->
  <link name="base_laser_link"/>
  <joint name="laser_joint" type="fixed">
    <origin xyz="0.053735 -0.0017816 0.12907" rpy="0 0 3.1416"/>
    <parent link="base_link"/>
    <child  link="base_laser_link"/>
  </joint>

  <!-- IMU (内置于下位机)
       注意: Cartographer 硬约束要求 IMU frame 必须与 tracking_frame
       (本项目 = base_link) 共位 (sensor_bridge.cpp:136 检查
       translation().norm() < 1e-5). 因此这里强制 origin=0,
       而非 SolidWorks 模型给出的精确值 (0.0041, -3.6e-5, 0.0195).
       1.95cm 的 Z 偏移对 2D SLAM 影响可忽略. -->
  <link name="imu"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child  link="imu"/>
  </joint>

</robot>
